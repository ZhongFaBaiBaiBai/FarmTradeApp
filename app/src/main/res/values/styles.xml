<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== 文字 ==================== -->
    <style name="Text.PageTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_page_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Text.PageSubtitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">#CCFFFFFF</item>
    </style>

    <style name="Text.SectionTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_section_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Label" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Amount" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_amount</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/green_primary</item>
    </style>

    <!-- ==================== 卡片 ==================== -->
    <style name="Widget.FarmTrade.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <style name="Widget.FarmTrade.Card.Flat" parent="Widget.FarmTrade.Card">
        <item name="cardElevation">0dp</item>
    </style>

    <!-- ==================== 按钮 ==================== -->
    <style name="Widget.FarmTrade.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/radius_s</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/green_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.FarmTrade.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_s</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.FarmTrade.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">@dimen/radius_s</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ToggleGroup 内的分段按钮：选中实心绿，未选白底描边 -->
    <style name="Widget.FarmTrade.Button.Toggle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_s</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/chip_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/button_toggle_text</item>
        <item name="backgroundTint">@color/button_toggle_bg</item>
        <item name="android:minHeight">42dp</item>
    </style>

    <!-- ==================== Chip ==================== -->
    <style name="Widget.FarmTrade.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">15sp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
    </style>

    <!-- ==================== 输入框 ==================== -->
    <style name="Widget.FarmTrade.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_s</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/green_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="Widget.FarmTrade.EditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ==================== 底部导航 ==================== -->
    <style name="Widget.FarmTrade.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">23dp</item>
        <item name="itemTextAppearanceActive">@style/Text.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/Text.BottomNav</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Text.BottomNav" parent="TextAppearance.AppCompat">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="Text.BottomNav.Active" parent="TextAppearance.AppCompat">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/green_primary</item>
    </style>

    <!-- ==================== FAB ==================== -->
    <style name="Widget.FarmTrade.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/green_primary</item>
        <item name="tint">@color/white</item>
        <item name="elevation">6dp</item>
        <item name="fabCustomSize">60dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.FarmTrade.Fab</item>
    </style>

    <style name="ShapeAppearanceOverlay.FarmTrade.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

</resources>
