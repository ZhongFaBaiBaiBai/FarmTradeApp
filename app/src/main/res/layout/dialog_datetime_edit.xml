<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#ffffff"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <!-- Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="编辑：日期时间"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- 文本输入框（手动敲格式） -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:boxStrokeColor="#1565c0"
        app:hintTextColor="#1565c0">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDatetimeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:maxLines="1"
            android:gravity="center"
            android:hint="输入日期（yyyy-MM-dd 或 yyyy-MM-dd HH:mm）" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 横向两个按钮：选日期 + 选时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickFromWheel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📅 选日期"
            android:textColor="#1565c0"
            android:textSize="15sp"
            app:strokeColor="#1565c0"
            app:cornerRadius="8dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickTime"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏰ 选时间（可选）"
            android:textColor="#757575"
            android:textSize="15sp"
            app:strokeColor="#bdbdbd"
            app:cornerRadius="8dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Cancel / Confirm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDatetime"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="取消"
            android:textColor="#888888"
            android:textSize="17sp"
            app:strokeColor="#e8e8e8"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmDatetime"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="确认"
            android:textColor="#ffffff"
            android:textSize="17sp"
            app:backgroundTint="#2e7d32"
            app:cornerRadius="10dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
